    minnum=9999
    totall=0
    for y in range(N):
        for x in range(N):
            if x not in before and arr[y][x] != 0:
                minnum=min(minnum,arr[y][x])
        for x in range(N):
            if x not in before:
                    if minnum == arr[y][x]:
                        before.append(x)
                        totall+=arr[y][x]
        minnum=9999
    return(totall) 
            
            
