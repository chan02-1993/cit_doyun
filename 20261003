"def soluition(arr,n,m):
    board=[]
    result=0
    for i in range(n):
        board.append([1]*5)
    for h in range(m):
        y=arr[h][0]
        x=arr[h][1]
        for i in range(arr[h][2]):
            if x+i+1 >= 5:
                break
            board[y][x+i+1]=0
            #오른쪽
        for i in range(arr[h][2]):
            if x-i-1 >= 5:
                break
            board[y][x-i-1]=0
            #왼쪽
        for i in range(arr[h][2]):
            if y+i+1 >= 5:
                break
            board[y+i+1][x]=0
            #아래
        for i in range(arr[h][2]):
            if y-i-1 >= 5:
                break
            board[y-i-1][x]=0
            #위
    for i in range(len(board)):
        for h in range(len(board[i])):
            result+=board[i][h]
    return(result)
    
    
print(soluition([[2,2,2],[0,0,1]],5,2))
