"def make_grades(name,score):
    grades=dict()
    for i in range(len(name)):
        if score[i]>=90:
            grades[name[i]]=""A""
        elif score[i]>=70:
            grades[name[i]]=""B""
        else:
            grades[name[i]]=""C""
    return(grades)
print(make_grades([""철수"", ""영희"", ""민수""], [95, 82, 68]))
