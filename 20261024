    maxnum=0
    minnum=999999999999999
    num=0
    #가로
    for y in range(len(board)):
        for x in range(len(board[1])):
        #정사각형 이므로 첫번째 줄의 길이는 각 줄의 가로의 길이와 모두 같음.
            num+=board[y][x]
        maxnum=max(num,maxnum)
        minnum=min(num,minnum)
        num=0
    #세로
    for x in range(len(board[1])):
        for y in range(len(board)):
        #세로는 y가 x보다 먼저 바뀐다.
            num+=board[y][x]
        maxnum=max(num,maxnum)
        minnum=min(num,minnum)
        num=0
    #대각선
    for y in range(len(board)):
        num+=board[y][y]
    maxnum=max(num,maxnum)
    minnum=min(num,minnum)
    num=0
    for y in range(len(board)):
        num+=board[y][4-y]
    maxnum=max(num,maxnum)
    minnum=min(num,minnum)
    num=0

    result=maxnum//5+minnum//5
    return(result)
