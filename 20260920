def ispal3(pal):
    newpal=""
    for i in range(len(pal)):
        newpal+=pal[len(pal)-i-1]
    return newpal==pal
        


        
def isp(prime):
    for i in range(2,int(prime**0.5)+1):
        if prime%i==0:
            return(False)
    return(True)
        
