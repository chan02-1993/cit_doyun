
def solution(n,m,area,c):

    board=[]
    for x in range(n):
        board.append([0]*n)

    red=(c)%3+1
    blue=(c+1)%3+1


    for i in range(m):
        if area[i][4]!=red:
            continue
        rect = area[i]

        startx = rect[0]
        endx = rect[2]
        starty = rect[1]
        endy = rect[3]
        for x in range(startx,endx+1):
            for y in range(starty,endy+1):
                board[y][x] = red
                
    for i in range(m):
        if area[i][4]!=blue:
            continue
        rect = area[i]

        startx = rect[0]
        endx = rect[2]
        starty = rect[1]
        endy = rect[3]

        for x in range(startx,endx+1):
            for y in range(starty,endy+1):
                if board[y][x]==0:
                    board[y][x] = blue
                else:
                    board[y][x] = c

    ans=0
    for y in range(n):
        for x in range(n):
            if board[y][x]==c:
                ans+=1
        
    return ans

t=solution(10,2,[[1,1,5,4,1],[3,3,6,6,3]],2)
print(t)
