def soluition(n,m,area,c):
    board=[]
    red=0
    blue=0
    gray=c
    if c == 1:
        red = 2
        blue = 3
    if c == 2:
        red = 1
        blue = 3
    if c == 3:
        red = 2
        blue = 1
    #색갈 숫자 설정
    for i in range(n):
        board.append([0]*n)
    # board 만들기

    for i in range(c-1):
        left = area[i][0]
        top = area[i][1]
        right = area[i][2]
        down = area[i][3]
        color = area[i][4]

        for y in range(top, down+1):
            for x in range(left,right+1):
                if board[y][x]==0 or board[y][x] == color:
                    board[y][x] = color
                else:
                    board[y][x] = gray



    
        
    
    
    
    print(board)
    result=0
    for y in range(n):
        for x in range(n):
            if board[y][x]==gray:
                result+=1
    return(result)
            
        
        
    
            
        
